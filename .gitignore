# -- 虚拟环境与 Python 产物 ----------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/

# -- 本地配置与凭证（**绝不能提交**：里面有 SESSDATA / z_c0 / API key）----
.env
# 本地配置：含个人路径（含 paths.cache_dir），每个人不一样
b2textify.toml

