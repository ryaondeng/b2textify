# 复制成 .env 后填值（.env 不进版本库）。
# 缓存目录（原始物 / 转写 / 译文缓存）。**默认不改**：不填就走
#   Windows: %LOCALAPPDATA%\b2textify\cache
#   其他:    ~/.cache/b2textify/cache
# 想集中到某个盘再放开下面这行（优先级：命令行 --cache > 这里 > toml 的 paths.cache_dir > 默认）
# B2T_CACHE_DIR=E:\b2textify-cache

# B 站：浏览器登录 → F12 → Application → Cookies → bilibili.com → 复制 SESSDATA 的值（裸 token）
# 真实值形态：<32位十六进制>,<10位时间戳>,<随机串>*<两位数字>，含逗号与 `%2C`
# 这里**不放假 token**：假值看起来像真的，容易被原样复制进 .env，最后只报 -101 却查不出原因
B2T_BILI_SESSDATA=<把 Cookies 里 SESSDATA 的值粘贴到这里>
# 知乎：同样从 Cookies 里取 z_c0 的值（回答正文需要登录态）
B2T_ZHIHU_COOKIE=<把 Cookies 里 z_c0 的值粘贴到这里>

# 本地转写用的 whisper 模型缓存。已经有 medium（约 1.5G）就指到那个目录，省一次下载：
#   Windows 默认在 %USERPROFILE%\.cache\huggingface\hub
# 没配也能用：首次转写会自动下载到默认位置。
# HF_HUB_CACHE=<你的模型缓存目录>

# 中文译文（b2textify-translate）用的对话模型，OpenAI 兼容接口。
# **只有走翻译才需要**：提取/转写链路完全不碰它，不配也能正常用。
B2T_LLM_API_KEY=<sk-...>
# 换服务只改这两行（自建 vLLM / 通义 / Moonshot 都行）
B2T_LLM_BASE_URL=https://api.deepseek.com
B2T_LLM_MODEL=deepseek-chat
